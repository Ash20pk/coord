{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "${KNOOT_BIN:-knoot} hook",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${KNOOT_BIN:-knoot} hook",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "${KNOOT_BIN:-knoot} hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${KNOOT_BIN:-knoot} hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${KNOOT_BIN:-knoot} hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "${KNOOT_BIN:-knoot} hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}